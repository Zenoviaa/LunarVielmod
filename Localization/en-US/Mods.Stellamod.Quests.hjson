TalkToZui: {
	DisplayName: Talk to Zui
	Description: You've just found yourself in a new land! Find out what exactly is going on around here.
	Objective: Talk to Zui in the Witch Town.
	IntroText: ""
}

CraftAtCauldron: {
	DisplayName: Let's get Cooking!
	Description: To kick off your enrollment at the academy, Zui has asked you to brew up something with the Ivythorn she gave you. See what you can make!
	Objective: Open the cauldron, put the 10 ivythorn in, and craft.
	IntroText: ""
}

