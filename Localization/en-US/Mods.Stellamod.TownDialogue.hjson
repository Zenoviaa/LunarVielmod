BishinineStart: {
	Line0:
		'''
		[PORTRAIT=Bishinine]
		Sneaking up on me now are you?
		'''
	Line1:
		'''
		[PORTRAIT=Bishinine]
		Well. No matter...
		You've been going around making a name for yourself you know?
		'''
	Line2:
		'''
		[PORTRAIT=Bishinine]
		Ereshy is gonna really like it if I tear you to shreds, maybe even big brother will compliment me!
		'''
	Line3:
		'''
		[PORTRAIT=Bishinine]
		She might even talk to me again!!
		'''
	Line4:
		'''
		[PORTRAIT=Bishinine]
		You hear that? That means you gotta go!
		'''
	Line5:
		'''
		[PORTRAIT=Bishinine]
		Not like you stand a chance against one of Illuria's Great Generals anyways. Let alone the Royals...
		'''
	Line6:
		'''
		[PORTRAIT=Bishinine]
		Running is useless, I am the fastest and most deadly of the generals...
		'''
	Line7:
		'''
		[PORTRAIT=Bishinine]
		Prepare yourself!
		'''
	DisplayName: ""
}

RysaGotAnythingDialogue: {
	Line0:
		'''
		[PORTRAIT=Rysa]
		Hey dude!
		'''
	Line1:
		'''
		[PORTRAIT=Rysa]
		Um yeah, I have some items in my shop with some vanitites and whatnot, why don't you take a peak?
		'''
	Line2:
		'''
		[PORTRAIT=Rysa]
		I'm Rysa by the way, I just make some goofy little things in my shop.
		'''
	Line3:
		'''
		[PORTRAIT=Rysa]
		Nice to meet you.
		'''
	DisplayName: Got anything for me?
}

RysaLivingDialogue: {
	Line0:
		'''
		[PORTRAIT=Rysa]
		Yep, I work best out here honestly.
		'''
	Line1:
		'''
		[PORTRAIT=Rysa]
		I was thinking of attending the witch academy, but I need to make up some money to go.
		'''
	Line2:
		'''
		[PORTRAIT=Rysa]
		Speaking of money, I've got a shop that I've spent a lot of work organizing, so please get some stuff!
		'''
	Line3:
		'''
		[PORTRAIT=Rysa]
		It'd help me a lot.
		'''
	DisplayName: Living all out on your own?
}

