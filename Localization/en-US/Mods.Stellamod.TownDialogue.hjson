		'''
	DisplayName: I don't want to worship...
}

MinervaStartDialogue: {
	Line0:
		'''
		[PORTRAIT=Minerva]
		What are you doing down here?
		'''
	Line1:
		'''
		[PORTRAIT=Minerva]
		Are you yet another that is trying to trample upon my garden?
		'''
	Line2:
		'''
		[PORTRAIT=Minerva]
		I'm sorry, but this pretty refuge is mine and mine alone!
		You have no place in it!
		'''
	Line3:
		'''
		[PORTRAIT=Minerva]
		Begone!
		'''
	DisplayName: Trample Garden
}

ZuiComeQuickDialogue: {
	Line0:
		'''
		[PORTRAIT=Zui]
		Hey um, I don't know how to say this, but could you come over here?
		'''
	Line1:
		'''
		[PORTRAIT=Zui]
		We have a big problem.
		'''
	Line2:
		'''
		[PORTRAIT=Zui]
		Something looks like they are about to attack the witch town.
		'''
	Line3:
		'''
		[PORTRAIT=Zui]
		Please hurry.
		'''
	DisplayName: Zui!
}

ZuiWhoAreYouDialogue: {
	Line0:
		'''
		[PORTRAIT=Zui]
		I'm glad you made it...
		'''
	Line1:
		'''
		[PORTRAIT=Zui]
		More importantly, who are you??
		'''
	DisplayName: Who are you???
}

ZuiTalkingToYouDialogue: {
	Line0:
		'''
		[PORTRAIT=Zui]
		Hey I'm talking to you, y'know!! If you don't answer you better leave this place...
		'''
	Line1:
		'''
		[PORTRAIT=Zui]
		I don't like scouting, state your purpose.
		'''
	Line2: If you're with Ereshkigal, you better say something...
	DisplayName: Who are you???
}

EFoundYouDialogue: {
	Line0:
		'''
		[PORTRAIT=E]
		Found you...
		'''
	DisplayName: E Found Your Mom
}

ZuiGetOuttaHereDialogue: {
	Line0:
		'''
		[PORTRAIT=Zui]
		This isn't good...
		'''
	Line1:
		'''
		[PORTRAIT=Zui]
		Get out of here!!
		'''
	DisplayName: Who are you???
}
EEndingDialogue: {
	Line0:
		'''
		[PORTRAIT=EreshDark]
		Styr...
		'''
	Line1:
		'''
		[PORTRAIT=E]
		.....
		'''
	Line2:
		'''
		[PORTRAIT=E]
		Yes?
		'''
	Line3:
		'''
		[PORTRAIT=E]
		I'm getting rid of them.
		'''
	Line4:
		'''
		[PORTRAIT=E]
		We need this.
		'''
	Line5:
		'''
		[PORTRAIT=EreshDark]
		You're out of time...
		'''
	Line6:
		'''
		[PORTRAIT=EreshDark]
		And I would like my sword back too...
		'''
	Line7:
		'''
		[PORTRAIT=E]
		But I'm not done here yet!
		'''
	Line8:
		'''
		[PORTRAIT=E]
		These idiots shouldn't even be able to get near you my love.
		'''
	Line9:
		'''
		[PORTRAIT=EreshDark]
		Sure, sure... I can handle that myself.
		'''
	Line10:
		'''
		[PORTRAIT=EreshDark]
		Please do return my sword now though, otherwise it will soon eat you alive.
		'''
	Line11:
		'''
		[PORTRAIT=EreshDark]
		I do not need to lose a member of my troupe
		'''
	Line12:
		'''
		[PORTRAIT=EreshDark]
		Return now...
		'''
	Line13:
		'''
		[PORTRAIT=E]
		Yes ma'am.
		'''
	DisplayName: Who are you???
}
EFearDialogue: {
	Line0:
		'''
		[PORTRAIT=E]
		Until we meet again, you.
		'''
	Line1:
		'''
		[PORTRAIT=E]
		You now know my name.
		'''
	Line2:
		'''
		[PORTRAIT=E]
		It will strike fear in you next we meet.
		'''
	Line3:
		'''
		[PORTRAIT=E]
		You'll be gone.
		'''
	Line4:
		'''
		[PORTRAIT=E]
		Styr.
		'''
	Line5:
		'''
		[PORTRAIT=E]
		Remember me.
		'''
	Line6:
		'''
		[PORTRAIT=E]
		Even if I don't have this sword, you will perish...
		'''
	DisplayName: Who are you???
}
