BishinineStart: {
	Line0:
		'''
		[PORTRAIT=Bishinine]
		Sneaking up on me now are you?
		'''
	Line1:
		'''
		[PORTRAIT=Bishinine]
		Well. No matter...
		You've been going around making a name for yourself you know?
		'''
	Line2:
		'''
		[PORTRAIT=Bishinine]
		Ereshy is gonna really like it if I tear you to shreds, maybe even big brother will compliment me!
		'''
	Line3:
		'''
		[PORTRAIT=Bishinine]
		She might even talk to me again!!
		'''
	Line4:
		'''
		[PORTRAIT=Bishinine]
		You hear that? That means you gotta go!
		'''
	Line5:
		'''
		[PORTRAIT=Bishinine]
		Not like you stand a chance against one of Illuria's Great Generals anyways. Let alone the Royals...
		'''
	Line6:
		'''
		[PORTRAIT=Bishinine]
		Running is useless, I am the fastest and most deadly of the generals...
		'''
	Line7:
		'''
		[PORTRAIT=Bishinine]
		Prepare yourself!
		'''
	DisplayName: ""
}

RysaGotAnythingDialogue: {
	Line0:
		'''
		[PORTRAIT=Rysa]
		Hey dude!
		'''
	Line1:
		'''
		[PORTRAIT=Rysa]
		Um yeah, I have some items in my shop with some vanitites and whatnot, why don't you take a peak?
		'''
	Line2:
		'''
		[PORTRAIT=Rysa]
		I'm Rysa by the way, I just make some goofy little things in my shop.
		'''
	Line3:
		'''
		[PORTRAIT=Rysa]
		Nice to meet you.
		'''
	DisplayName: Got anything for me?
}

RysaLivingDialogue: {
	Line0:
		'''
		[PORTRAIT=Rysa]
		Yep, I work best out here honestly.
		'''
	Line1:
		'''
		[PORTRAIT=Rysa]
		I was thinking of attending the witch academy, but I need to make up some money to go.
		'''
	Line2:
		'''
		[PORTRAIT=Rysa]
		Speaking of money, I've got a shop that I've spent a lot of work organizing, so please get some stuff!
		'''
	Line3:
		'''
		[PORTRAIT=Rysa]
		It'd help me a lot.
		'''
	DisplayName: Living all out on your own?
}

JiitasStartDialogue: {
	Line0:
		'''
		[PORTRAIT=Jiitas]
		Wait...
		'''
	Line1:
		'''
		[PORTRAIT=Jiitas]
		NONONONo.
		'''
	Line2:
		'''
		[PORTRAIT=Jiitas]
		You don�t want to worship Sirestias, our great and eldest???? 
		That cannot stand, not under my rule...
		'''
	Line3:
		'''
		[PORTRAIT=Jiitas]
		You scareeeee me.
		'''
	Line4:
		'''
		[PORTRAIT=Jiitas]
		I�m gonna get ya.
		'''
	DisplayName: I don't want to worship...
}

MinervaStartDialogue: {
	Line0:
		'''
		[PORTRAIT=Minerva]
		What are you doing down here?
		'''
	Line1:
		'''
		[PORTRAIT=Minerva]
		Are you yet another that is trying to trample upon my garden?
		'''
	Line2:
		'''
		[PORTRAIT=Minerva]
		I'm sorry, but this pretty refuge is mine and mine alone!
		You have no place in it!
		'''
	Line3:
		'''
		[PORTRAIT=Minerva]
		Begone!
		'''
	DisplayName: Trample Garden
}

ZuiComeQuickDialogue: {
	Line0:
		'''
		[PORTRAIT=Zui]
		Hey um, I don't know how to say this, but could you come over here?
		'''
	Line1:
		'''
		[PORTRAIT=Zui]
		We have a big problem.
		'''
	Line2:
		'''
		[PORTRAIT=Zui]
		Something looks like they are about to attack the witch town.
		'''
	Line3:
		'''
		[PORTRAIT=Zui]
		Please hurry.
		'''
	DisplayName: Zui!
}

ZuiWhoAreYouDialogue: {
	Line0:
		'''
		[PORTRAIT=Zui]
		I'm glad you made it...
		'''
	Line1:
		'''
		[PORTRAIT=Zui]
		More importantly, who are you??
		'''
	DisplayName: Who are you???
}

ZuiTalkingToYouDialogue: {
	Line0:
		'''
		[PORTRAIT=Zui]
		Hey I'm talking to you, y'know!! If you don't answer you better leave this place...
		'''
	Line1:
		'''
		[PORTRAIT=Zui]
		I don't like scouting, state your purpose.
		'''
	Line2: If you're with Ereshkigal, you better say something...
	DisplayName: Who are you???
}

EFoundYouDialogue: {
	Line0:
		'''
		[PORTRAIT=E]
		Found you...
		'''
	DisplayName: E Found Your Mom
}

ZuiGetOuttaHereDialogue: {
	Line0:
		'''
		[PORTRAIT=Zui]
		This isn't good...
		'''
	Line1:
		'''
		[PORTRAIT=Zui]
		Get out of here!!
		'''
	DisplayName: Who are you???
}

EEndingDialogue: {
	Line0:
		'''
		[PORTRAIT=EreshDark]
		Styr...
		'''
	Line1:
		'''
		[PORTRAIT=E]
		.....
		'''
	Line2:
		'''
		[PORTRAIT=E]
		Yes?
		'''
	Line3:
		'''
		[PORTRAIT=E]
		I'm getting rid of them.
		'''
	Line4:
		'''
		[PORTRAIT=E]
		We need this.
		'''
	Line5:
		'''
		[PORTRAIT=EreshDark]
		You're out of time...
		'''
	Line6:
		'''
		[PORTRAIT=EreshDark]
		And I would like my sword back too...
		'''
	Line7:
		'''
		[PORTRAIT=E]
		But I'm not done here yet!
		'''
	Line8:
		'''
		[PORTRAIT=E]
		These idiots shouldn't even be able to get near you my love.
		'''
	Line9:
		'''
		[PORTRAIT=EreshDark]
		Sure, sure... I can handle that myself.
		'''
	Line10:
		'''
		[PORTRAIT=EreshDark]
		Please do return my sword now though, otherwise it will soon eat you alive.
		'''
	Line11:
		'''
		[PORTRAIT=EreshDark]
		I do not need to lose a member of my troupe
		'''
	Line12:
		'''
		[PORTRAIT=EreshDark]
		Return now...
		'''
	Line13:
		'''
		[PORTRAIT=E]
		Yes ma'am.
		'''
	DisplayName: Who are you???
}

EFearDialogue: {
	Line0:
		'''
		[PORTRAIT=E]
		Until we meet again, you.
		'''
	Line1:
		'''
		[PORTRAIT=E]
		You now know my name.
		'''
	Line2:
		'''
		[PORTRAIT=E]
		It will strike fear in you next we meet.
		'''
	Line3:
		'''
		[PORTRAIT=E]
		You'll be gone.
		'''
	Line4:
		'''
		[PORTRAIT=E]
		Styr.
		'''
	Line5:
		'''
		[PORTRAIT=E]
		Remember me.
		'''
	Line6:
		'''
		[PORTRAIT=E]
		Even if I don't have this sword, you will perish...
		'''
	DisplayName: Who are you???
}

BaseDialogue.Line0: ""

BulbtrifierHiDialogue: {
	DisplayName: Hi?
	Line0:
		'''
		[PORTRAIT=Bulbtrifier]
		Hi, do you care to get anything from this shop? The name is Bulbtrifier and we always have new and fresh selections!
		'''
	Line1:
		'''
		[PORTRAIT=Bulbtrifier]
		Afterall, I make the best food in the entire world! Even Zui has eaten here before...
		'''
	Line2:
		'''
		[PORTRAIT=Bulbtrifier]
		Grab a bite, or hell, get some drinks too.
		'''
}

BulbtrifierWhoDialogue: {
	DisplayName: Who is that lady at the top?
	Line0:
		'''
		[PORTRAIT=Bulbtrifier]
		I am not so sure, she kind of joined along for the ride, but she hasn't left and she keeps telling me about how her sister is a succubus.
		'''
	Line1:
		'''
		[PORTRAIT=Bulbtrifier]
		You could say I pulled a baddie...
		'''
	Line2:
		'''
		[PORTRAIT=Bulbtrifier]
		Well I did, I'm the best cook afterall.
		'''
	Line3:
		'''
		[PORTRAIT=Bulbtrifier]
		I need to kick her out, but she is like an immovable object.
		'''
}

BulbtrifierHowMuchDialogue: {
	DisplayName: How much do you make?
	Line0:
		'''
		[PORTRAIT=Bulbtrifier]
		A bit of a rude question...
		'''
	Line1:
		'''
		[PORTRAIT=Bulbtrifier]
		But if you ask, I make plenty of money! I just might need a little bit of help...
		'''
	Line2:
		'''
		[PORTRAIT=Bulbtrifier]
		I may join that witch academy Zui posts about everywhere, it's so renowned...
		'''
	Line3:
		'''
		[PORTRAIT=Bulbtrifier]
		I'm sure to get some money there!
		'''
}

