	Label: Foreground
	Tooltip: Controls the opacity of foreground elements
}

ShadowQuality: {
	Label: Shadow Quality
	Tooltip: Affects how precise shadow calculations are, reduce this if you're having issues with performance, this does not do anything if Beaming Lights is off.
}

